# Copy to .env.local for local dev. Never commit real values.
# On Vercel these live in Project Settings -> Environment Variables.

# Groq API key (server-side only, must never reach the browser)
GROQ_API_KEY=

# Fallback chain, tried left to right on 429 / 5xx.
GROQ_MODELS=llama-3.1-8b-instant,openai/gpt-oss-20b,llama-3.3-70b-versatile

# Comma-separated exact origins. No wildcards, no trailing slashes.
ALLOWED_ORIGINS=https://4skills.co,https://www.4skills.co,https://4skills.app

# Google Apps Script web-app deployment URL that appends leads to the Sheet.
LEAD_WEBHOOK_URL=

# Digits only, country code first. Used to build wa.me handoff links.
WHATSAPP_NUMBER=923322410155
